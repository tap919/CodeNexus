{
  "name": "@codenexus/policy-engine",
  "version": "1.0.0",
  "description": "Single source of truth for CodeNexus risk classification, merge gating, waiver management, and normative rules",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
