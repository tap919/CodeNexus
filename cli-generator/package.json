{
  "name": "@codenexus/cli-generator",
  "version": "1.0.0",
  "description": "CodeNexus CLI Generator — Fused from CLI-Anything: main `codenexus` CLI entry point with subcommands (review, fix, audit, watch, status, configure, auth). Integrates all modules via the control plane orchestrator.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codenexus": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/yargs": "^17.0.33",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
